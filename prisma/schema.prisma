generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Rol {
  INQUILINO
  PROPIETARIO
  ADMINISTRADOR
}

enum EstadoSolicitud {
  PENDIENTE
  ACEPTADA
  RECHAZADA

  @@map("estado_solicitud")
}

enum EstadoKyc {
  PENDIENTE
  ESCANEANDO
  COMPLETADO
  FALLIDO

  @@map("estado_kyc")
}

// --- MODELOS ---

model Usuario {
  id                String   @id @default(uuid())
  email             String   @unique
  contrasena_hash   String
  nombre_completo   String
  dni_nie           String?  @unique
  rol               Rol      @default(INQUILINO)

  stripe_account_id          String?  @unique
  stripe_onboarding_complete Boolean  @default(false)
  verificado_kyc             Boolean  @default(false)
  nombre_kyc        String?
  apellidos_kyc     String?
  tipo_documento    String?

  viviendas               Vivienda[]
  solicitudes_inquilino   Solicitud[]      @relation("inquilino")
  solicitudes_propietario Solicitud[]      @relation("propietario")
  pagos                   Pago[]
  kyc_sesiones            KycSesion[]

  fecha_creacion    DateTime @default(now())
  ultima_conexion   DateTime @updatedAt

  @@map("usuarios")
}

model Vivienda {
  id                    String   @id @default(uuid())
  propietario           Usuario  @relation(fields: [propietario_id], references: [id])
  propietario_id        String

  titulo                String
  descripcion           String?
  direccion             String   @default("")
  barrio                String?
  ciudad                String   @default("Donostia-San Sebastián")
  provincia             String   @default("")
  precio_mes            Decimal  @default(0) @db.Decimal(10, 2)
  fianza_importe        Decimal  @default(0) @db.Decimal(10, 2)
  habitaciones          Int      @default(1)
  banos                 Int      @default(1)
  m2                    Float    @default(0)
  motivos               String[] @default([])
  fotos                 String[] @default([])

  num_registro_vivienda String?  @unique
  fase_actual            Int      @default(1)
  es_borrador            Boolean  @default(false)
  nota_simple_url       String?
  verificada            Boolean  @default(false)
  activa                Boolean  @default(true)

  disponible_desde      DateTime?
  duracion_minima       String?
  estancia_minima       Int      @default(1)
  estancia_maxima       Int      @default(12)

  solicitudes           Solicitud[]
  pagos                 Pago[]
  fecha_creacion        DateTime @default(now())

  @@index([activa, es_borrador])
  @@index([provincia])
  @@index([propietario_id])
  @@map("viviendas")
}

model Solicitud {
  id                       String          @id @default(uuid())
  vivienda                 Vivienda        @relation(fields: [vivienda_id], references: [id])
  vivienda_id              String
  inquilino                Usuario         @relation("inquilino", fields: [inquilino_id], references: [id])
  inquilino_id             String
  propietario              Usuario         @relation("propietario", fields: [propietario_id], references: [id])
  propietario_id           String

  motivo                   String
  motivo_detalle           String?
  documento_identidad_url  String
  documento_justificativo_url String

  fecha_entrada            DateTime
  fecha_salida             DateTime
  estado                   EstadoSolicitud @default(PENDIENTE)
  motivo_rechazo           String?

  contrato                 ContratoDigital?
  pagos                    Pago[]

  fecha_creacion           DateTime        @default(now())

  @@index([inquilino_id])
  @@index([propietario_id])
  @@index([estado])
  @@index([vivienda_id, estado])
  @@map("solicitudes")
}

model ContratoDigital {
  id                   String    @id @default(uuid())
  solicitud            Solicitud @relation(fields: [solicitud_id], references: [id])
  solicitud_id         String    @unique

  pdf_borrador_url     String?
  pdf_final_url        String?
  firmado_propietario  Boolean   @default(false)
  firmado_inquilino    Boolean   @default(false)
  firma_propietario_img String?
  firma_inquilino_img  String?

  fecha_firma_completa DateTime?

  @@map("contratos_digitales")
}

model Pago {
  id             String    @id @default(uuid())
  solicitud      Solicitud @relation(fields: [solicitud_id], references: [id])
  solicitud_id   String
  inquilino      Usuario   @relation(fields: [inquilino_id], references: [id])
  inquilino_id   String
  vivienda       Vivienda  @relation(fields: [vivienda_id], references: [id])
  vivienda_id    String

  concepto       String
  importe        Decimal   @db.Decimal(10, 2)
  estado         String    @default("COMPLETADO")
  metodo         String    @default("tarjeta")

  stripe_payment_intent_id String? @unique

  comision_plataforma      Decimal? @db.Decimal(10, 2)
  comision_host            Decimal? @db.Decimal(10, 2)
  comision_guest           Decimal? @db.Decimal(10, 2)
  importe_propietario      Decimal? @db.Decimal(10, 2)

  fecha_pago     DateTime  @default(now())

  @@index([solicitud_id])
  @@index([inquilino_id])
  @@map("pagos")
}

model StripeWebhookEvent {
  event_id    String   @id
  received_at DateTime @default(now())

  @@map("stripe_webhook_events")
}

model KycSesion {
  id              String    @id @default(uuid())
  usuario         Usuario   @relation(fields: [usuario_id], references: [id])
  usuario_id      String
  token           String    @unique @default(uuid())
  estado          EstadoKyc @default(PENDIENTE)

  safe_score      Int?
  nfc_verificado  Boolean   @default(false)
  nombre_extraido String?
  apellidos_extraidos String?
  dni_extraido    String?
  tipo_documento  String?
  datos_raw       Json?

  expira_en       DateTime
  creado_en       DateTime  @default(now())
  actualizado_en  DateTime  @updatedAt

  @@index([usuario_id])
  @@map("kyc_sesiones")
}
